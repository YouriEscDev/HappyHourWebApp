# Rust/Axum API base URL. Server-side only — must NOT be NEXT_PUBLIC_,
# the auth server actions read it and the browser never sees it.
API_BASE_URL=http://127.0.0.1:3000

# Google Identity Services client id. Must equal GOOGLE_CLIENT_ID on the
# Rust side, which checks it as the `aud` claim in verify_google_token().
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
